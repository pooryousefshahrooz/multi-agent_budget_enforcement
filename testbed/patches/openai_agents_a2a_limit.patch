--- a/agents/a2a.py	1970-01-01 01:00:00
+++ b/agents/a2a.py	2026-10-27 14:38:55
@@ -0,0 +1,180 @@
+"""Serve an agent over A2A (Agent2Agent protocol 1.0, via ``a2a-sdk``), honouring the delegated-work limit the
+caller attaches to the request.
+
+A caller that delegates work may put a ``limit`` on the A2A message metadata (or the request metadata)::
+
+    {"limit": {"max_depth": 2, "deadline": 1793099255.6, "max_cost_usd": 0.01}}
+
+``max_depth`` is the number of delegation hops left (the caller has already taken its own hop off), ``deadline`` a
+Unix time, ``max_cost_usd`` a budget. The run of a request carrying a limit stays within it:
+
+* no hop left (``max_depth < 1``), a deadline already passed, or a budget smaller than one model call: the task is
+  rejected and no run starts;
+* the deadline bounds the run's wall-clock time (the run is cancelled when it passes);
+* the budget bounds the run's turns: ``max_turns = budget // usd_per_call`` (``usd_per_call`` is the server's price
+  of one model call; without it the budget is not converted).
+
+The server's own ``max_turns`` stays an upper bound. Usage::
+
+    from agents.a2a import to_a2a
+    app = to_a2a(agent, url="http://127.0.0.1:9000", usd_per_call=0.001)   # a Starlette app
+
+``agent`` may be an ``Agent`` or a factory: an async context manager function yielding the ``Agent`` for one request
+(for agents whose MCP servers are connected per request). ``on_run_end`` receives an ``A2ARunRecord`` for every
+request.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import time
+from collections.abc import Awaitable, Callable
+from dataclasses import dataclass, field
+from typing import Any, Union
+
+from .agent import Agent
+from .exceptions import MaxTurnsExceeded
+from .run import Runner
+from .run_config import DEFAULT_MAX_TURNS, RunConfig
+
+AgentSource = Union[Agent[Any], Callable[[], contextlib.AbstractAsyncContextManager[Agent[Any]]]]
+
+
+class DelegationLimitExhausted(Exception):
+    """The request's limit leaves no room for a run (no hop left, deadline passed, or budget below one call)."""
+
+
+class DeadlineExceeded(Exception):
+    """The run did not finish before the request's deadline."""
+
+
+@dataclass
+class A2ARunRecord:
+    """What one A2A request ran with and how it ended."""
+
+    limit: dict[str, Any] | None
+    max_turns: int | None
+    timeout_s: float | None
+    outcome: str  # "completed" | "rejected" | "max_turns" | "deadline" | "error"
+    error: str | None = None
+    extra: dict[str, Any] = field(default_factory=dict)
+
+
+def received_limit(message_metadata: dict[str, Any] | None,
+                   request_metadata: dict[str, Any] | None) -> dict[str, Any] | None:
+    """The ``limit`` attached to the message, else to the request."""
+    for meta in (message_metadata, request_metadata):
+        if meta and isinstance(meta.get("limit"), dict):
+            return dict(meta["limit"])
+    return None
+
+
+def run_bounds(limit: dict[str, Any] | None, max_turns: int | None,
+               usd_per_call: float | None) -> tuple[int | None, float | None]:
+    """(max_turns, timeout in seconds) for a run under ``limit``; raises DelegationLimitExhausted when no run fits."""
+    if not limit:
+        return max_turns, None
+    if limit.get("max_depth") is not None and limit["max_depth"] < 1:
+        raise DelegationLimitExhausted("no delegation depth left")
+    timeout = None
+    if limit.get("deadline") is not None:
+        timeout = float(limit["deadline"]) - time.time()
+        if timeout <= 0:
+            raise DelegationLimitExhausted("deadline passed")
+    if limit.get("max_cost_usd") is not None and usd_per_call:
+        calls = int(float(limit["max_cost_usd"]) // usd_per_call)
+        if calls < 1:
+            raise DelegationLimitExhausted("cost budget used up")
+        max_turns = calls if max_turns is None else min(calls, max_turns)
+    return max_turns, timeout
+
+
+def _agent_cm(agent: AgentSource) -> contextlib.AbstractAsyncContextManager[Agent[Any]]:
+    if isinstance(agent, Agent):
+        return contextlib.nullcontext(agent)
+    return agent()
+
+
+def make_executor(agent: AgentSource, *, max_turns: int | None = DEFAULT_MAX_TURNS,
+                  usd_per_call: float | None = None, run_config: RunConfig | None = None,
+                  on_run_end: Callable[[A2ARunRecord], Awaitable[None] | None] | None = None) -> Any:
+    """An ``a2a.server.agent_execution.AgentExecutor`` running ``agent`` with ``Runner.run`` per A2A request."""
+    from a2a.helpers import get_message_text, new_task_from_user_message, new_text_message, new_text_part
+    from a2a.server.agent_execution import AgentExecutor
+    from a2a.server.tasks import TaskUpdater
+    from a2a.types import TaskState
+    from google.protobuf import json_format
+
+    def _dict(proto: Any) -> dict[str, Any] | None:
+        return json_format.MessageToDict(proto) if proto is not None and proto.ListFields() else None
+
+    async def _report(record: A2ARunRecord) -> None:
+        if on_run_end is not None:
+            res = on_run_end(record)
+            if asyncio.iscoroutine(res):
+                await res
+
+    class OpenAIAgentsA2AExecutor(AgentExecutor):
+        async def execute(self, context: Any, event_queue: Any) -> None:
+            task = context.current_task or new_task_from_user_message(context.message)
+            await event_queue.enqueue_event(task)
+            up = TaskUpdater(event_queue=event_queue, task_id=task.id, context_id=task.context_id)
+            limit = received_limit(_dict(context.message.metadata), context.metadata)
+            try:
+                turns, timeout = run_bounds(limit, max_turns, usd_per_call)
+            except DelegationLimitExhausted as e:
+                await up.reject(new_text_message(f"Delegation limit exhausted: {e}"))
+                await _report(A2ARunRecord(limit, None, None, "rejected", str(e)))
+                return
+            await up.update_status(state=TaskState.TASK_STATE_WORKING)
+            outcome, error = "completed", None
+            try:
+                async with _agent_cm(agent) as a:
+                    run = Runner.run(a, get_message_text(context.message), max_turns=turns, run_config=run_config)
+                    try:
+                        result = await asyncio.wait_for(run, timeout) if timeout is not None else await run
+                    except asyncio.TimeoutError as e:
+                        raise DeadlineExceeded(f"run stopped at the request's deadline ({timeout:.0f}s)") from e
+                await up.add_artifact(parts=[new_text_part(text=str(result.final_output))])
+                await up.complete()
+            except MaxTurnsExceeded as e:
+                outcome, error = "max_turns", f"MaxTurnsExceeded: {e}"
+                await up.failed(new_text_message(error))
+            except DeadlineExceeded as e:
+                outcome, error = "deadline", f"DeadlineExceeded: {e}"
+                await up.failed(new_text_message(error))
+            except Exception as e:  # noqa: BLE001
+                outcome, error = "error", f"{type(e).__name__}: {e}"
+                await up.failed(new_text_message(error[:500]))
+            await _report(A2ARunRecord(limit, turns, timeout, outcome, error))
+
+        async def cancel(self, context: Any, event_queue: Any) -> None:
+            raise NotImplementedError
+
+    return OpenAIAgentsA2AExecutor()
+
+
+def to_a2a(agent: AgentSource, *, url: str, name: str | None = None, description: str | None = None,
+           max_turns: int | None = DEFAULT_MAX_TURNS, usd_per_call: float | None = None,
+           run_config: RunConfig | None = None,
+           on_run_end: Callable[[A2ARunRecord], Awaitable[None] | None] | None = None) -> Any:
+    """A Starlette app serving ``agent`` over A2A 1.0 (JSON-RPC) at ``url``, with its Agent Card."""
+    from a2a.server.request_handlers import DefaultRequestHandler
+    from a2a.server.routes import create_agent_card_routes, create_jsonrpc_routes
+    from a2a.server.tasks import InMemoryTaskStore
+    from a2a.types import AgentCapabilities, AgentCard, AgentInterface, AgentSkill
+    from starlette.applications import Starlette
+
+    label = name or (agent.name if isinstance(agent, Agent) else "agent")
+    card = AgentCard(name=label, description=description or label, version="1.0",
+                     default_input_modes=["text/plain"], default_output_modes=["text/plain"],
+                     capabilities=AgentCapabilities(streaming=False),
+                     supported_interfaces=[AgentInterface(protocol_binding="JSONRPC", url=url,
+                                                          protocol_version="1.0")],
+                     skills=[AgentSkill(id="run", name=label, description=description or label, tags=["agent"])])
+    handler = DefaultRequestHandler(
+        agent_executor=make_executor(agent, max_turns=max_turns, usd_per_call=usd_per_call,
+                                     run_config=run_config, on_run_end=on_run_end),
+        task_store=InMemoryTaskStore(), agent_card=card)
+    return Starlette(routes=create_agent_card_routes(card) + create_jsonrpc_routes(handler, "/"))
