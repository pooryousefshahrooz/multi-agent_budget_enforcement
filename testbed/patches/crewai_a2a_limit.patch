+def _received_limit(context: RequestContext) -> dict[str, Any] | None:
+    """The delegated-work limit the caller attached to this request: ``limit`` in the message metadata, else in the
+    request metadata. Fields: max_depth (hops left), deadline (Unix time), max_cost_usd."""
+    for meta in (context.message.metadata if context.message else None, context.metadata):
+        if meta and isinstance(meta.get("limit"), dict):
+            return cast(dict[str, Any], meta["limit"])
+    return None
+
+
+def _limited_agent(
+    agent: Agent, limit: dict[str, Any], server_config: A2AServerConfig | None
+) -> Agent:
+    """A copy of the agent for this request only, whose run stays within the received limit: no hop left rejects
+    the task; the deadline becomes max_execution_time; the cost budget becomes max_iter at the server's
+    usd_per_call. The agent's own settings stay as an upper bound."""
+    if limit.get("max_depth") is not None and limit["max_depth"] < 1:
+        raise ServerError(InvalidParamsError(message="Delegation limit exhausted: no delegation depth left"))
+    update: dict[str, Any] = {}
+    if limit.get("deadline") is not None:
+        left = int(float(limit["deadline"]) - time.time())
+        if left < 1:
+            raise ServerError(InvalidParamsError(message="Delegation limit exhausted: deadline passed"))
+        update["max_execution_time"] = min(left, agent.max_execution_time or left)
+    price = server_config.usd_per_call if server_config else None
+    if limit.get("max_cost_usd") is not None and price:
+        calls = int(float(limit["max_cost_usd"]) // price)
+        if calls < 1:
+            raise ServerError(InvalidParamsError(message="Delegation limit exhausted: cost budget used up"))
+        update["max_iter"] = min(calls, agent.max_iter)
+    return agent.model_copy(update=update) if update else agent
+
+
